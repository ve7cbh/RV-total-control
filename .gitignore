# SAMLUX bridge script -- contains port numbers that are intentionally kept
# private and excluded from the public repo.
config/scripts/samlux_mqtt.py
config/docs/samlux_mqtt.txt

# Python bytecode cache -- regenerable, never belongs in git
__pycache__/
*.pyc

# Backup files that shouldn't accumulate in the repo
*.bak
*.bak-*
*~

# Installer binaries -- not config, don't belong here
*.exe
*.msi
# Any other stray token/credential dump files
docs/influx_API_Token.txt

# Runtime state files -- rewritten by services, and contain the RV's live
# GPS position, which should not be published in this public repo.
config/scripts/imu_heading_state.json
config/weewx_location_state.json

# Kept outside the repo in ~/rvtc-files/ (host) -- vendor installers, driver
# bundles, big data exports and logs don't belong in a public config repo.
CP210x*
platform-tools*
*.xlsx
/*.csv
logs/
*.log
