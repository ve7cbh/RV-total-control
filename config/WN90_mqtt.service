# /etc/systemd/system/WN90_mqtt.service
[Unit]
Description=Ecowitt WN90LP Weather Station MQTT Bridge
After=network.target

[Service]
Type=simple
User=ve7cbh
WorkingDirectory=/home/ve7cbh/RV-total-control
ExecStart=/usr/bin/python3 -u /home/ve7cbh/RV-total-control/config/WN90_mqtt.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
