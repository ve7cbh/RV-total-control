[Unit]
Description=RVTC GPS-to-MQTT bridge
# Ordering only, not a hard requirement — gpsd may still take a moment to
# activate its device after the gateway comes reachable, which is why the
# Restart= line below matters as much as this ordering does.
After=gpsd.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/ve7cbh/RV-total-control/gps_mqtt.py
Restart=on-failure
RestartSec=10
User=ve7cbh

# Same lesson as gpsd's own service today: if gpsd or the gateway isn't
# ready yet at boot, don't silently give up — just keep retrying.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
