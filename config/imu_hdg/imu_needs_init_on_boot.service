[Unit]
Description=RVTC — flag IMU heading as needing re-init at boot (HW-27)
# Runs once at every boot, before imu_mqtt.service starts, and marks the
# heading offset as untrusted. Rationale: the WitMotion and the J45 are
# expected to share a 12V supply, so a host reboot is a reasonable (if
# imperfect) proxy for "the IMU may have lost power and lost its heading
# lock too." Not foolproof -- if the IMU ever ends up on a separately
# switched circuit, an IMU-only power cycle won't trip this. Roll/Pitch are
# unaffected either way; only Yaw/heading needs this (see System Reference
# Section 7 for why).
Before=imu_mqtt.service
Wants=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -c "\
import json, os; \
path = '/home/ve7cbh/RV-total-control/config/imu_heading_state.json'; \
state = {}; \
os.path.exists(path) and state.update(json.load(open(path))); \
state['needs_init'] = True; \
json.dump(state, open(path, 'w'), indent=2)"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
