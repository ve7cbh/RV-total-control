[Unit]
Description=MeshCore ADVERT decoder -> node name directory (MQTT)
After=network.target

[Service]
Type=simple
User=ve7cbh
WorkingDirectory=/home/ve7cbh/RV-total-control
ExecStart=/usr/bin/python3 -u /home/ve7cbh/RV-total-control/config/scripts/meshcore_name_resolver.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
