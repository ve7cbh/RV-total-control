# mosquitto.conf
# Managed by Ansible — do not edit manually

listener {{ mosquitto_port }}
allow_anonymous true

# WebSocket listener -- for browser-based dashboards (RVTC Telemetry tab,
# Master Caution) to connect directly from the LAN. Added 2026-08.
listener {{ mosquitto_ws_port }}
protocol websockets

persistence {{ mosquitto_persistence | lower }}
persistence_location /mosquitto/data/

log_dest {{ mosquitto_log_dest }}
log_type error
log_type warning
log_type notice
log_type information
