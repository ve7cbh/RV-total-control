# weewx.conf — generated by Ansible
# WeeWX 5.x — Acurite 5n1 via MQTT/rtl_433

[Station]
    station_type = MQTTSubscribe
    station_url = mqtt://{{ weewx_mqtt_host }}:{{ weewx_mqtt_port }}/
    location = {{ weewx_station_name }}
    latitude = {{ weewx_latitude }}
    longitude = {{ weewx_longitude }}
    altitude = {{ weewx_altitude }}, meter
    week_start = 6

[MQTTSubscribeDriver]
    driver = user.MQTTSubscribe.MQTTSubscribeDriver
    host = {{ weewx_mqtt_host }}
    port = {{ weewx_mqtt_port }}
    keepalive = 60
    [[topic]]
        [[[{{ weewx_mqtt_topic }}]]]
            unit_system = US
            [[[[wind_avg_km_h]]]]
                name = windSpeed
                units = km_per_hour
            [[[[wind_dir_deg]]]]
                name = windDir
            [[[[temperature_F]]]]
                name = outTemp
                units = degree_F
            [[[[humidity]]]]
                name = outHumidity
            [[[[rain_in]]]]
                name = rain
                units = inch

[StdConvert]
    target_unit = METRIC

[StdArchive]
    archive_interval = 300

[StdReport]
    [[SeasonsReport]]
        skin = Seasons
        enable = true

[InfluxDB2]
    host = {{ influxdb_host }}
    port = {{ influxdb_port }}
    org = {{ influxdb_org }}
    bucket = {{ influxdb_bucket }}
    token = {{ influxdb_token }}
    measurement = weewx

[Engine]
    [[Services]]
        archive_services = weewx.engine.StdArchive, user.influxdb3.InfluxDB2Writer
